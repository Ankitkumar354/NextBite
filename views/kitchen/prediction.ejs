<div class="container py-5">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold">
                Food Demand Prediction
            </h1>

            <p class="text-muted">
                Add historical food consumption data
                to improve future demand predictions.
            </p>

        </div>


        <a href="/dashboard/kitchen" class="btn btn-outline-secondary">

            ← Dashboard

        </a>

    </div>


    <!-- DATA ENTRY -->

    <div class="card border-0 shadow-sm mb-5">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">
                Add Consumption Record
            </h4>

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-2">
                        🤖 Predict Food Demand
                    </h4>

                    <p class="text-muted">
                        Use historical consumption data to estimate
                        tomorrow's food demand.
                    </p>


                    <form action="/dashboard/kitchen/prediction/predict" method="POST">

                        <div class="row g-3">

                            <div class="col-md-5">

                                <label class="form-label fw-semibold">
                                    Food Name
                                </label>

                                <input type="text" name="foodName" class="form-control" placeholder="e.g. Rice"
                                    required>

                            </div>


                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Expected Customers
                                </label>

                                <input type="number" name="expectedCustomers" class="form-control" min="1" required>

                            </div>


                            <div class="col-md-3">

                                <label class="form-label fw-semibold">
                                    Special Event
                                </label>

                                <select name="specialEvent" class="form-select">

                                    <option value="false">
                                        No
                                    </option>

                                    <option value="true">
                                        Yes
                                    </option>

                                </select>

                            </div>


                            <div class="col-12">

                                <button type="submit" class="btn btn-primary">

                                    🤖 Generate Prediction

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <form action="/dashboard/kitchen/prediction/consumption" method="POST">


                <div class="row g-3">


                    <!-- FOOD NAME -->

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">

                            Food Name

                        </label>

                        <input type="text" name="foodName" class="form-control" placeholder="e.g. Rice" required>

                    </div>


                    <!-- CATEGORY -->

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">

                            Category

                        </label>

                        <select name="category" class="form-select" required>

                            <option value="cooked_food">
                                Cooked Food
                            </option>

                            <option value="raw_material">
                                Raw Material
                            </option>

                            <option value="bakery">
                                Bakery
                            </option>

                            <option value="fruits_vegetables">
                                Fruits & Vegetables
                            </option>

                            <option value="dairy">
                                Dairy
                            </option>

                            <option value="other">
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- DATE -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Date

                        </label>

                        <input type="date" name="date" class="form-control" required>

                    </div>


                    <!-- CUSTOMERS -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Expected Customers

                        </label>

                        <input type="number" name="expectedCustomers" class="form-control" min="0" required>

                    </div>


                    <!-- UNIT -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            Unit

                        </label>

                        <select name="unit" class="form-select">

                            <option value="plates">
                                Plates
                            </option>

                            <option value="kg">
                                Kg
                            </option>

                            <option value="litres">
                                Litres
                            </option>

                            <option value="units">
                                Units
                            </option>

                        </select>

                    </div>


                    <!-- PREPARED -->

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">

                            Prepared Quantity

                        </label>

                        <input type="number" name="preparedQuantity" class="form-control" min="0" step="0.1" required>

                    </div>


                    <!-- CONSUMED -->

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">

                            Consumed Quantity

                        </label>

                        <input type="number" name="consumedQuantity" class="form-control" min="0" step="0.1" required>

                    </div>


                    <!-- SPECIAL EVENT -->

                    <div class="col-12">

                        <div class="form-check">

                            <input class="form-check-input" type="checkbox" name="specialEvent" value="true"
                                id="specialEvent">

                            <label class="form-check-label" for="specialEvent">

                                Special event / high-demand day

                            </label>

                        </div>

                    </div>


                    <!-- NOTES -->

                    <div class="col-12">

                        <label class="form-label fw-semibold">

                            Notes

                        </label>

                        <textarea name="notes" class="form-control" rows="3"
                            placeholder="Optional information..."></textarea>

                    </div>


                    <!-- SUBMIT -->

                    <div class="col-12">

                        <button type="submit" class="btn btn-success px-4">

                            + Save Consumption Data

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ================================= -->
    <!-- HISTORY -->
    <!-- ================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="p-4 border-bottom">

                <h4 class="fw-bold mb-1">
                    Consumption History
                </h4>

                <p class="text-muted mb-0">
                    Recent food consumption records.
                </p>

            </div>


            <% if (records.length===0) { %>

                <div class="text-center py-5">

                    <h5>
                        No consumption data yet
                    </h5>

                    <p class="text-muted">
                        Add your first record above.
                    </p>

                </div>

                <% } else { %>


                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Food
                                    </th>

                                    <th>
                                        Customers
                                    </th>

                                    <th>
                                        Prepared
                                    </th>

                                    <th>
                                        Consumed
                                    </th>

                                    <th>
                                        Leftover
                                    </th>

                                    <th>
                                        Event
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% records.forEach(record=> { %>

                                    <tr>

                                        <td>

                                            <%= new Date( record.date ).toLocaleDateString() %>

                                        </td>


                                        <td>

                                            <strong>
                                                <%= record.foodName %>
                                            </strong>

                                            <br>

                                            <small class="text-muted">

                                                <%= record.category .replaceAll("_", " " ) %>

                                            </small>

                                        </td>


                                        <td>

                                            <%= record.expectedCustomers %>

                                        </td>


                                        <td>

                                            <%= record.preparedQuantity %>
                                                <%= record.unit %>

                                        </td>


                                        <td>

                                            <%= record.consumedQuantity %>
                                                <%= record.unit %>

                                        </td>


                                        <td>

                                            <span class="badge bg-warning text-dark">

                                                <%= record.leftoverQuantity %>
                                                    <%= record.unit %>

                                            </span>

                                        </td>


                                        <td>

                                            <% if (record.specialEvent) { %>

                                                <span class="badge bg-primary">
                                                    Special
                                                </span>

                                                <% } else { %>

                                                    <span class="text-muted">
                                                        Normal
                                                    </span>

                                                    <% } %>

                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } %>

        </div>

    </div>

</div>