<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Kitchen Dashboard</h1>

            <p class="text-muted mb-0">
                Welcome, <%= user.name %>
            </p>
        </div>


        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#productionModal">

            + Add Production

        </button>


        <a href="/dashboard/kitchen/surplus" class="btn btn-outline-success">

            Manage Surplus Food

        </a>

        <a href="/dashboard/kitchen/requests" class="btn btn-outline-primary">
            📋 Food Requests
        </a>

        <a href="/dashboard/kitchen/prediction" class="btn btn-primary">

            📊 Demand Prediction

        </a>

        <a href="/dashboard/kitchen/surplus-plans" class="btn btn-success">
            📦 Surplus Plans
        </a>

    </div>


    <!-- Statistics -->

    <div class="row g-4 mb-5">

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Expected Demand
                    </p>

                    <h2 class="fw-bold">
                        <%= stats.expectedDemand %>
                    </h2>

                    <small class="text-muted">
                        Total units
                    </small>

                </div>
            </div>

        </div>


        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Food Prepared
                    </p>

                    <h2 class="fw-bold">
                        <%= stats.preparedQuantity %>
                    </h2>

                    <small class="text-muted">
                        Total units
                    </small>

                </div>
            </div>

        </div>


        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Surplus Food
                    </p>

                    <h2 class="fw-bold text-success">
                        <%= stats.surplusQuantity %>
                    </h2>

                    <small class="text-muted">
                        Available for redistribution
                    </small>

                </div>
            </div>

        </div>


        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Food Wasted
                    </p>

                    <h2 class="fw-bold text-danger">
                        <%= stats.wastedQuantity %>
                    </h2>

                    <small class="text-muted">
                        Total units
                    </small>

                </div>
            </div>

        </div>

    </div>


    <!-- Production Records -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0">
                Recent Production Records
            </h5>

        </div>


        <div class="card-body p-0">

            <% if (records.length===0) { %>

                <div class="text-center py-5">

                    <h5>No production records yet</h5>

                    <p class="text-muted">
                        Add your first production record.
                    </p>

                </div>

                <% } else { %>

                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead>
                                <tr>
                                    <th>Food</th>
                                    <th>Date</th>
                                    <th>Demand</th>
                                    <th>Prepared</th>
                                    <th>Consumed</th>
                                    <th>Surplus</th>
                                    <th>Waste</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% records.forEach(record=> { %>

                                    <tr>

                                        <td>
                                            <strong>
                                                <%= record.foodItem %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= new Date(record.date).toLocaleDateString() %>
                                        </td>

                                        <td>
                                            <%= record.expectedDemand %>
                                        </td>

                                        <td>
                                            <%= record.preparedQuantity %>
                                        </td>

                                        <td>
                                            <%= record.consumedQuantity %>
                                        </td>

                                        <td>
                                            <span class="badge bg-success">
                                                <%= record.surplusQuantity %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge bg-danger">
                                                <%= record.wastedQuantity %>
                                            </span>
                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } %>

        </div>

    </div>

</div>


<!-- Production Modal -->

<div class="modal fade" id="productionModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Add Production Record
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal">
                </button>

            </div>


            <form action="/dashboard/kitchen/production" method="POST">

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Food Item
                            </label>

                            <input type="text" name="foodItem" class="form-control" placeholder="e.g. Rice" required>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Date
                            </label>

                            <input type="date" name="date" class="form-control" required>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Expected Demand
                            </label>

                            <input type="number" name="expectedDemand" class="form-control" min="0" required>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Prepared Quantity
                            </label>

                            <input type="number" name="preparedQuantity" class="form-control" min="0" required>

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Consumed
                            </label>

                            <input type="number" name="consumedQuantity" class="form-control" min="0" value="0">

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Surplus
                            </label>

                            <input type="number" name="surplusQuantity" class="form-control" min="0" value="0">

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Wasted
                            </label>

                            <input type="number" name="wastedQuantity" class="form-control" min="0" value="0">

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Unit
                            </label>

                            <select name="unit" class="form-select">

                                <option value="plates">
                                    Plates
                                </option>

                                <option value="kg">
                                    Kg
                                </option>

                                <option value="litres">
                                    Litres
                                </option>

                                <option value="units">
                                    Units
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Notes
                            </label>

                            <input type="text" name="notes" class="form-control" placeholder="Optional">

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit" class="btn btn-success">

                        Save Record

                    </button>

                </div>

            </form>



        </div>

    </div>

</div>