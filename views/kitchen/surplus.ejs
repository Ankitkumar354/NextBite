<div class="container py-5">

    <!-- =============================== -->
    <!-- HEADER -->
    <!-- =============================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                🍱 Surplus Food
            </h1>

            <p class="text-muted mb-0">
                Manage and publish surplus food available for redistribution.
            </p>
        </div>

        <button
            type="button"
            class="btn btn-success px-4"
            data-bs-toggle="modal"
            data-bs-target="#addSurplusModal">

            + Add Surplus Food

        </button>

    </div>


    <!-- =============================== -->
    <!-- STATISTICS -->
    <!-- =============================== -->

    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Total Listings</small>
                    <h2 class="fw-bold mb-0"><%= surplusFoods ? surplusFoods.length : 0 %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Available</small>
                    <h2 class="fw-bold text-success mb-0">
                        <%= surplusFoods ? surplusFoods.filter(food => food.status === "available").length : 0 %>
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Requested</small>
                    <h2 class="fw-bold text-warning mb-0">
                        <%= surplusFoods ? surplusFoods.filter(food => food.status === "requested").length : 0 %>
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Completed</small>
                    <h2 class="fw-bold text-primary mb-0">
                        <%= surplusFoods ? surplusFoods.filter(food => food.status === "completed").length : 0 %>
                    </h2>
                </div>
            </div>
        </div>

    </div>


    <!-- =============================== -->
    <!-- SURPLUS FOOD LIST -->
    <!-- =============================== -->

    <div class="mb-3">
        <h3 class="fw-bold mb-1">My Surplus Food</h3>
        <p class="text-muted">Food listings created by your kitchen.</p>
    </div>


    <% if (!surplusFoods || surplusFoods.length === 0) { %>

        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div style="font-size: 4rem;">🍱</div>
                <h5 class="fw-bold mt-3">No surplus food yet</h5>
                <p class="text-muted">
                    Add your first surplus food listing to make it available for redistribution.
                </p>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addSurplusModal">
                    + Add Surplus Food
                </button>
            </div>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% surplusFoods.forEach(food => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm h-100 overflow-hidden">

                        <!-- FOOD IMAGE -->
                        <% if (food.image && food.image.url) { %>
                            <img src="<%= food.image.url %>" class="card-img-top" alt="<%= food.foodName %>"
                                style="height:220px; object-fit:cover;">
                        <% } else { %>
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                style="height:220px; font-size:4rem;">
                                🍱
                            </div>
                        <% } %>


                        <div class="card-body d-flex flex-column">

                            <!-- FOOD NAME -->
                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <h5 class="fw-bold mb-0"><%= food.foodName %></h5>

                                <!-- STATUS -->
                                <% if (food.status === "available") { %>
                                    <span class="badge bg-success">Available</span>
                                <% } else if (food.status === "requested") { %>
                                    <span class="badge bg-warning text-dark">Requested</span>
                                <% } else if (food.status === "assigned") { %>
                                    <span class="badge bg-info text-dark">Assigned</span>
                                <% } else if (food.status === "picked_up") { %>
                                    <span class="badge bg-primary">Picked Up</span>
                                <% } else if (food.status === "completed") { %>
                                    <span class="badge bg-primary">Completed</span>
                                <% } else if (food.status === "expired") { %>
                                    <span class="badge bg-secondary">Expired</span>
                                <% } else if (food.status === "cancelled") { %>
                                    <span class="badge bg-danger">Cancelled</span>
                                <% } %>

                            </div>


                            <!-- 🤖 AI QUALITY BADGE -->
                            <% if (food.qualityStatus) { %>

                                <div class="mb-2">

                                    <% if (food.qualityStatus === "Fresh") { %>
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                            <i class="fa-solid fa-robot me-1"></i> AI: Fresh
                                        </span>
                                    <% } else if (food.qualityStatus === "Redistribute Immediately") { %>
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning">
                                            <i class="fa-solid fa-robot me-1"></i> AI: Redistribute Immediately
                                        </span>
                                    <% } else if (food.qualityStatus === "Spoiled / Compost") { %>
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger">
                                            <i class="fa-solid fa-robot me-1"></i> AI: Spoiled / Compost
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary">
                                            <i class="fa-solid fa-robot me-1"></i> AI: Pending Analysis
                                        </span>
                                    <% } %>

                                    <% if (food.shelfLifeHours !== null && food.shelfLifeHours !== undefined) { %>
                                        <small class="text-muted ms-1">
                                            (~<%= food.shelfLifeHours %>h shelf life<% if (food.aiConfidence) { %>, <%= Math.round(food.aiConfidence * 100) %>% confidence<% } %>)
                                        </small>
                                    <% } %>

                                </div>

                            <% } %>


                            <!-- CATEGORY -->
                            <p class="text-muted text-capitalize mb-3">
                                <%= food.category ? food.category.replaceAll("_", " ") : "Food" %>
                            </p>


                            <!-- QUANTITY -->
                            <div class="mb-3">
                                <small class="text-muted">Quantity</small>
                                <h3 class="fw-bold text-success mb-0">
                                    <%= food.quantity %> <%= food.unit %>
                                </h3>
                            </div>


                            <hr>


                            <!-- PREPARED AT -->
                            <p class="mb-2">
                                <strong>Prepared:</strong>
                                <span class="text-muted"><%= new Date(food.preparedAt).toLocaleString() %></span>
                            </p>


                            <!-- PICKUP DEADLINE -->
                            <p class="mb-2">
                                <strong>Pickup Before:</strong>
                                <br>
                                <span class="text-muted"><%= new Date(food.pickupDeadline).toLocaleString() %></span>
                            </p>


                            <!-- CITY -->
                            <p class="mb-2">
                                <strong>City:</strong>
                                <span class="text-muted"><%= food.city %></span>
                            </p>


                            <!-- ADDRESS -->
                            <p class="mb-2">
                                <strong>Pickup Address:</strong>
                                <br>
                                <span class="text-muted"><%= food.pickupAddress %></span>
                            </p>


                            <!-- DESCRIPTION -->
                            <% if (food.description) { %>
                                <p class="text-muted small mb-3"><%= food.description %></p>
                            <% } %>


                            <!-- ACTIONS -->
                            <div class="mt-auto pt-3">

                                <% if (food.status === "available") { %>

                                    <form action="/dashboard/kitchen/surplus/<%= food._id %>/cancel" method="POST"
                                        onsubmit="return confirm('Are you sure you want to cancel this food listing?');">
                                        <button type="submit" class="btn btn-outline-danger w-100">
                                            Cancel Listing
                                        </button>
                                    </form>

                                <% } else { %>

                                    <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                        Listing <%= food.status.replaceAll("_", " ") %>
                                    </button>

                                <% } %>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>



<!-- ================================================= -->
<!-- ADD SURPLUS FOOD MODAL -->
<!-- ================================================= -->

<div class="modal fade" id="addSurplusModal" tabindex="-1" aria-labelledby="addSurplusModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <!-- MODAL HEADER -->
            <div class="modal-header bg-success text-white">
                <div>
                    <h5 class="modal-title fw-bold" id="addSurplusModalLabel">🍱 Add Surplus Food</h5>
                    <small>Publish food available for redistribution.</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- FORM -->
            <form action="/dashboard/kitchen/surplus" method="POST" enctype="multipart/form-data">

                <div class="modal-body">

                    <div class="row g-3">

                        <!-- FOOD NAME -->
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Food Name</label>
                            <input type="text" name="foodName" class="form-control" placeholder="e.g. Vegetable Biryani" required>
                        </div>

                        <!-- CATEGORY -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="category" class="form-select" required>
                                <option value="cooked_food">Cooked Food</option>
                                <option value="raw_material">Raw Material</option>
                                <option value="bakery">Bakery</option>
                                <option value="fruits_vegetables">Fruits & Vegetables</option>
                                <option value="dairy">Dairy</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <!-- QUANTITY -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Quantity</label>
                            <input type="number" name="quantity" class="form-control" min="0.1" step="0.1" placeholder="Enter quantity" required>
                        </div>

                        <!-- UNIT -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Unit</label>
                            <select name="unit" class="form-select" required>
                                <option value="plates">Plates</option>
                                <option value="kg">Kg</option>
                                <option value="litres">Litres</option>
                                <option value="units">Units</option>
                            </select>
                        </div>

                        <!-- PREPARED AT -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Prepared At</label>
                            <input type="datetime-local" name="preparedAt" class="form-control" required>
                        </div>

                        <!-- PICKUP DEADLINE -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Pickup Deadline</label>
                            <input type="datetime-local" name="pickupDeadline" class="form-control" required>
                        </div>

                        <!-- PICKUP ADDRESS -->
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Pickup Address</label>
                            <input type="text" name="pickupAddress" class="form-control" placeholder="Enter pickup address" required>
                        </div>

                        <!-- CITY -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">City</label>
                            <input type="text" name="city" class="form-control" placeholder="e.g. Kanpur" required>
                        </div>

                        <!-- DESCRIPTION -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Describe the food, freshness, packaging, etc."></textarea>
                        </div>

                        <!-- FOOD IMAGE -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Food Photo</label>
                            <input type="file" name="image" id="foodImage" class="form-control" accept="image/jpeg,image/png,image/webp" required>
                            <small class="text-muted">JPG, PNG or WEBP. Maximum size: 5 MB.</small>
                        </div>

                        <!-- IMAGE PREVIEW -->
                        <div class="col-12 d-none" id="imagePreviewContainer">
                            <div class="mt-2">
                                <p class="fw-semibold mb-2">Image Preview</p>
                                <img id="imagePreview" src="" alt="Food Preview" class="img-fluid rounded shadow-sm" style="max-height:250px; object-fit:cover;">
                            </div>
                        </div>

                    </div>

                </div>

                <!-- MODAL FOOTER -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4">🍱 Publish Surplus Food</button>
                </div>

            </form>

        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- IMAGE PREVIEW SCRIPT -->
<!-- ================================================= -->

<script>

    const foodImage = document.getElementById("foodImage");
    const imagePreview = document.getElementById("imagePreview");
    const imagePreviewContainer = document.getElementById("imagePreviewContainer");

    if (foodImage) {

        foodImage.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {
                imagePreviewContainer.classList.add("d-none");
                imagePreview.src = "";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image size must be less than 5 MB.");
                this.value = "";
                imagePreviewContainer.classList.add("d-none");
                return;
            }

            const allowedTypes = ["image/jpeg", "image/png", "image/webp"];

            if (!allowedTypes.includes(file.type)) {
                alert("Only JPG, PNG and WEBP images are allowed.");
                this.value = "";
                imagePreviewContainer.classList.add("d-none");
                return;
            }

            const reader = new FileReader();

            reader.onload = function (event) {
                imagePreview.src = event.target.result;
                imagePreviewContainer.classList.remove("d-none");
            };

            reader.readAsDataURL(file);

        });

    }

</script>