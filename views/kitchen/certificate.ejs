<style>
    .cert {
        max-width: 820px;
        margin: 0 auto;
        padding: 48px;
        border: 6px double #198754;
        border-radius: 8px;
        background: #fff;
    }

    @media print {

        nav,
        footer,
        .no-print {
            display: none !important;
        }

        .cert {
            border-width: 4px;
            margin: 0;
            max-width: 100%;
        }

        body {
            background: #fff !important;
        }
    }
</style>

<div class="container py-5">

    <div class="no-print text-center mb-4">
        <button class="btn btn-success" onclick="window.print()">🖨️ Print / Save as PDF</button>
        <a href="/dashboard/kitchen/impact" class="btn btn-outline-secondary ms-2">Back</a>
    </div>

    <div class="cert text-center">
        <img src="/images/icon.jpeg" alt="NextBite logo" style="height:70px; width:auto; border-radius:8px;"
            class="mb-2">
        <p class="text-uppercase text-muted mb-1" style="letter-spacing:3px;">NextBite</p>

        <h1 class="fw-bold mb-1">Food Waste Diversion</h1>
        <h2 class="text-success mb-4">&amp; CO₂e Impact Certificate</h2>

        <p class="mb-1">This is to certify that</p>
        <h3 class="fw-bold mb-1">
            <%= kitchen.organizationName || kitchen.name %>
        </h3>
        <% if (kitchen.city) { %>
            <p class="text-muted">
                <%= kitchen.city %>
            </p>
            <% } %>

                <p class="mt-4">
                    redistributed surplus food to NGOs through the NextBite platform between
                    <strong>
                        <%= new Date(certificate.periodStart).toLocaleDateString("en-IN") %>
                    </strong>
                    and
                    <strong>
                        <%= new Date(certificate.periodEnd).toLocaleDateString("en-IN") %>
                    </strong>.
                </p>

                <div class="row my-4">
                    <div class="col-4">
                        <div class="fs-2 fw-bold">
                            <%= certificate.deliveries %>
                        </div>
                        <small class="text-muted">Verified deliveries</small>
                    </div>
                    <div class="col-4">
                        <div class="fs-2 fw-bold text-success">
                            <%= certificate.foodKg %> kg
                        </div>
                        <small class="text-muted">Food saved (est.)</small>
                    </div>
                    <div class="col-4">
                        <div class="fs-2 fw-bold text-primary">
                            <%= certificate.co2eKg %> kg
                        </div>
                        <small class="text-muted">CO₂e avoided (est.)</small>
                    </div>
                </div>

                <table class="table table-sm w-auto mx-auto text-start">
                    <thead>
                        <tr>
                            <th>Unit</th>
                            <th>Quantity delivered</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% certificate.breakdown.forEach(b=> { %>
                            <tr>
                                <td>
                                    <%= b.unit %>
                                </td>
                                <td>
                                    <%= b.quantity %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>

                <hr class="my-4">

                <p class="small text-muted mb-1">
                    <strong>Method:</strong>
                    <%= methodNote %>
                        Factors used: <%= certificate.factors.co2ePerKgFood %> kg CO₂e per kg food;
                            weight per unit:
                            <%= Object.entries(certificate.factors.kgPerUnit) .map(([u, kg])=> `${u} = ${kg}
                                kg`).join(", ") %>.
                </p>

                <p class="small text-muted mb-3">
                    <strong>Disclaimer:</strong> This is an impact statement issued by NextBite based on
                    platform-recorded deliveries. It is not a government-issued document or a tax certificate.
                    Eligibility for any tax benefit depends on applicable law; please consult your tax advisor.
                </p>

                <p class="small mb-0">
                    Certificate ID: <strong>
                        <%= certificate.certificateId %>
                    </strong><br>
                    Issued: <%= new Date(certificate.issuedAt).toLocaleDateString("en-IN") %><br>
                        Verify at: <%= verifyUrl %>
                </p>

    </div>
</div>