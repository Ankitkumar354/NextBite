<div class="container py-5">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                User Management
            </h1>

            <p class="text-muted mb-0">
                Manage SmartFood AI platform users.
            </p>

        </div>


        <a
            href="/dashboard/admin"
            class="btn btn-outline-secondary">

            ← Dashboard

        </a>

    </div>


    <!-- ROLE FILTER -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form
                action="/dashboard/admin/users"
                method="GET"
                class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Filter by Role
                    </label>

                    <select
                        name="role"
                        class="form-select">

                        <option
                            value="all"
                            <%= selectedRole === "all"
                                ? "selected"
                                : "" %>>

                            All Users

                        </option>


                        <option
                            value="kitchen"
                            <%= selectedRole === "kitchen"
                                ? "selected"
                                : "" %>>

                            Kitchens

                        </option>


                        <option
                            value="ngo"
                            <%= selectedRole === "ngo"
                                ? "selected"
                                : "" %>>

                            NGOs

                        </option>


                        <option
                            value="delivery"
                            <%= selectedRole === "delivery"
                                ? "selected"
                                : "" %>>

                            Delivery

                        </option>


                        <option
                            value="processing"
                            <%= selectedRole === "processing"
                                ? "selected"
                                : "" %>>

                            Processing Units

                        </option>


                        <option
                            value="admin"
                            <%= selectedRole === "admin"
                                ? "selected"
                                : "" %>>

                            Admins

                        </option>

                    </select>

                </div>


                <div class="col-md-auto">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Apply Filter

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- USER TABLE -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <% if (users.length === 0) { %>

                <div class="text-center py-5">

                    <div class="fs-1">
                        👥
                    </div>

                    <h5 class="fw-bold mt-3">
                        No users found
                    </h5>

                    <p class="text-muted">
                        There are no users matching this filter.
                    </p>

                </div>

            <% } else { %>


                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Organization
                                </th>

                                <th>
                                    City
                                </th>

                                <th>
                                    Verification
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% users.forEach(account => { %>

                                <tr>

                                    <!-- USER -->

                                    <td>

                                        <div class="fw-semibold">

                                            <%= account.name %>

                                        </div>

                                        <small class="text-muted">

                                            <%= account.email %>

                                        </small>

                                    </td>


                                    <!-- ROLE -->

                                    <td>

                                        <% if (account.role === "admin") { %>

                                            <span class="badge bg-dark">
                                                Admin
                                            </span>

                                        <% } else if (account.role === "kitchen") { %>

                                            <span class="badge bg-success">
                                                Kitchen
                                            </span>

                                        <% } else if (account.role === "ngo") { %>

                                            <span class="badge bg-primary">
                                                NGO
                                            </span>

                                        <% } else if (account.role === "delivery") { %>

                                            <span class="badge bg-warning text-dark">
                                                Delivery
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">
                                                Processing
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ORGANIZATION -->

                                    <td>

                                        <%= account.organizationName
                                            || "-" %>

                                    </td>


                                    <!-- CITY -->

                                    <td>

                                        <%= account.city
                                            || "-" %>

                                    </td>


                                    <!-- VERIFICATION -->

                                    <td>

                                        <% if (account.isVerified) { %>

                                            <span class="badge bg-success">
                                                Verified
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-warning text-dark">
                                                Unverified
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (account.isActive) { %>

                                            <span class="badge bg-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTION -->

                                    <td>

                                        <% if (
                                            account._id.toString()
                                            !==
                                            user._id.toString()
                                        ) { %>

                                            <form
                                                action="/dashboard/admin/users/<%= account._id %>/toggle-status"
                                                method="POST">

                                                <% if (account.isActive) { %>

                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                        Deactivate

                                                    </button>

                                                <% } else { %>

                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm btn-outline-success">

                                                        Activate

                                                    </button>

                                                <% } %>

                                            </form>

                                        <% } else { %>

                                            <span class="text-muted small">
                                                Current Admin
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>