
<div class="container py-5">

    <!-- =====================================
         HEADER
    ====================================== -->

    <div class="text-center mb-5">

        <span class="badge bg-success px-3 py-2 rounded-pill">
            NextBite
        </span>

        <h1 class="fw-bold mt-3">
            How It Works
        </h1>

        <p class="text-muted mx-auto" style="max-width: 700px;">
            NextBite connects institutional kitchens, NGOs,
            administrators and delivery partners to reduce food
            waste and redistribute surplus food efficiently.
        </p>

    </div>


    <!-- =====================================
         WORKFLOW
    ====================================== -->

    <div class="row g-4">


        <!-- STEP 1 -->

        <div class="col-12 col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                <div class="card-body p-4">

                    <div class="bg-success-subtle
                                text-success
                                rounded-circle
                                d-flex
                                align-items-center
                                justify-content-center
                                mx-auto
                                mb-3"
                         style="width:75px;height:75px;font-size:32px;">

                        🍱

                    </div>

                    <span class="badge bg-success rounded-pill">
                        Step 01
                    </span>

                    <h5 class="fw-bold mt-3">
                        Kitchen Publishes Surplus
                    </h5>

                    <p class="text-muted">
                        Kitchens add surplus food with its
                        quantity, pickup location and deadline.
                    </p>

                </div>

            </div>

        </div>


        <!-- STEP 2 -->

        <div class="col-12 col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                <div class="card-body p-4">

                    <div class="bg-success-subtle
                                text-success
                                rounded-circle
                                d-flex
                                align-items-center
                                justify-content-center
                                mx-auto
                                mb-3"
                         style="width:75px;height:75px;font-size:32px;">

                        📦

                    </div>

                    <span class="badge bg-success rounded-pill">
                        Step 02
                    </span>

                    <h5 class="fw-bold mt-3">
                        NGO Requests Food
                    </h5>

                    <p class="text-muted">
                        NGOs browse available surplus food
                        and request the quantity they need.
                    </p>

                </div>

            </div>

        </div>


        <!-- STEP 3 -->

        <div class="col-12 col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                <div class="card-body p-4">

                    <div class="bg-success-subtle
                                text-success
                                rounded-circle
                                d-flex
                                align-items-center
                                justify-content-center
                                mx-auto
                                mb-3"
                         style="width:75px;height:75px;font-size:32px;">

                        ✅

                    </div>

                    <span class="badge bg-success rounded-pill">
                        Step 03
                    </span>

                    <h5 class="fw-bold mt-3">
                        Kitchen Approves
                    </h5>

                    <p class="text-muted">
                        The kitchen reviews the request and
                        approves or rejects it based on availability.
                    </p>

                </div>

            </div>

        </div>


        <!-- STEP 4 -->

        <div class="col-12 col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                <div class="card-body p-4">

                    <div class="bg-success-subtle
                                text-success
                                rounded-circle
                                d-flex
                                align-items-center
                                justify-content-center
                                mx-auto
                                mb-3"
                         style="width:75px;height:75px;font-size:32px;">

                        🚚

                    </div>

                    <span class="badge bg-success rounded-pill">
                        Step 04
                    </span>

                    <h5 class="fw-bold mt-3">
                        Delivery Assignment
                    </h5>

                    <p class="text-muted">
                        Approved requests are assigned to an
                        available delivery person.
                    </p>

                </div>

            </div>

        </div>


    </div>


    <!-- =====================================
         SECOND ROW
    ====================================== -->

    <div class="row g-4 mt-2">


        <!-- STEP 5 -->

        <div class="col-12 col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="bg-primary-subtle
                                    text-primary
                                    rounded-circle
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    flex-shrink-0"
